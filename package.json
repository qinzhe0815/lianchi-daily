{
  "name": "lianchi-daily",
  "version": "1.6.0",
  "description": "按《健身Excel超级套表》规则生成饮食训练计划的 iOS / Android App",
  "scripts": {
    "test": "node test/engine.test.js && node test/profiles.test.js && node test/tables.test.js && node test/platform.test.js && node test/storage.test.js && node test/privacy.test.js && node test/updater.test.js && node test/notifications.test.js",
    "serve": "python3 -m http.server 8766 --directory www",
    "sync": "npx cap sync android",
    "icons": "python3 scripts/make-icons.py",
    "sync:ios": "npx cap sync ios",
    "open:ios": "npx cap open ios",
    "run:ios": "npx cap run ios",
    "check:ios": "node scripts/check-ios.js",
    "test:native": "node scripts/test-native.js"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.0.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  },
  "private": true
}
